TZ={{ docker_registry_environment_variables_tz }}

REGISTRY_STORAGE_DELETE_ENABLED={{ docker_registry_storage_delete_enabled }}

{% if docker_registry_log_level %}
REGISTRY_LOG_LEVEL={{ docker_registry_log_level }}
{% endif %}

{# An empty value is meaningful here: it is what keeps the debug/metrics listener closed. #}
REGISTRY_HTTP_DEBUG_ADDR={{ docker_registry_http_debug_addr }}

{% if docker_registry_http_headers %}
REGISTRY_HTTP_HEADERS={{ docker_registry_http_headers | to_json }}
{% endif %}

{{ docker_registry_environment_variables_additional_variables }}
